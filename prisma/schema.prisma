generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
  NGO
  MODERATOR
  SUPPORT
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING
  DEACTIVATED
}

enum SellerVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum BusinessType {
  RESTAURANT
  HOTEL
  BAKERY
  CAFE
  MESS
  CATERER
  WEDDING_EVENT
  SUPERMARKET
  CLOUD_KITCHEN
  CORPORATE_CAFETERIA
  OTHER
}

enum ListingType {
  EXACT
  SURPRISE_BOX
}

enum FoodType {
  VEGETARIAN
  NON_VEGETARIAN
  VEGAN
  JAIN
  OTHER
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SOLD_OUT
  EXPIRED
  BLOCKED
  CANCELLED
}

enum ListingUnit {
  PORTION
  PIECE
  BOX
  KG
  GRAM
  LITER
  PACK
  ITEM
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  COMPLETED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum PickupStatus {
  PENDING
  READY
  PICKED_UP
  CANCELLED
}

enum FulfillmentMethod {
  PICKUP
  DELIVERY
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP_FROM_SELLER
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryProviderMode {
  FOODBITE
  SELLER
  THIRD_PARTY
}

enum DonationStatus {
  DRAFT
  AVAILABLE
  RESERVED
  ACCEPTED
  READY_FOR_PICKUP
  COLLECTED
  COMPLETED
  CANCELLED
  EXPIRED
  FAILED_COLLECTION
}

enum DonationReservationStatus {
  ACTIVE
  CANCELLED
  COLLECTED
  EXPIRED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  WHATSAPP
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  CANCELLED
}

enum NotificationType {
  ORDER_CREATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ORDER_CONFIRMED
  ORDER_PREPARING
  ORDER_READY_FOR_PICKUP
  ORDER_PICKED_UP
  ORDER_COMPLETED
  ORDER_CANCELLED
  REFUND_PENDING
  REFUND_COMPLETED
  NEW_SELLER_ORDER
  OPERATIONAL_ALERT
  DELIVERY_ASSIGNED
  DELIVERY_IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERY_DELIVERED
  DELIVERY_FAILED
  DONATION_AVAILABLE
  DONATION_RESERVED
  DONATION_ACCEPTED
  DONATION_READY
  DONATION_COLLECTED
  DONATION_COMPLETED
  DONATION_CANCELLED
  DONATION_EXPIRED
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  phone String? @unique
  passwordHash String
  role UserRole @default(BUYER)
  status AccountStatus @default(PENDING)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  buyerProfile BuyerProfile?
  sellerProfile SellerProfile?
  accounts Account[]
  sessions Session[]
  favorites Favorite[]
  cart Cart?
  orders Order[]
  reservations Reservation[]
  auditLogs AuditLog[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  addresses Address[]
  ngoProfile NGOProfile?
  @@index([status])
  @@index([role])
}

model BuyerProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  name String
  dateOfBirth DateTime?
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  address String?
  city String?
  state String?
  pincode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model SellerProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  businessId String? @db.Uuid
  verificationStatus SellerVerificationStatus @default(PENDING)
  trustScore Decimal @default(0) @db.Decimal(5, 2)
  totalListings Int @default(0)
  totalOrders Int @default(0)
  completedOrders Int @default(0)
  cancelledOrders Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  listings FoodListing[]
  orderItems OrderItem[]
  donations Donation[]
  @@index([businessId])
}

model Business {
  id String @id @default(uuid()) @db.Uuid
  name String
  type BusinessType?
  description String?
  phone String?
  email String?
  address String?
  city String?
  state String?
  pincode String?
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  deliveryAvailable Boolean @default(false)
  deliveryRadiusKm Decimal? @db.Decimal(6, 2)
  deliveryBaseFee Int @default(0)
  deliveryPerKmFee Int @default(0)
  fssaiNumber String?
  fssaiDocumentUrl String?
  verificationStatus SellerVerificationStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sellers SellerProfile[]
}

model NGOProfile {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  organizationName String
  contactPerson String
  phone String?
  description String?
  serviceArea String?
  address String?
  operatingHours String?
  verificationStatus SellerVerificationStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations DonationReservation[]
  @@index([verificationStatus])
}

model FoodCategory {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  description String?
  imageUrl String?
  isActive Boolean @default(true)
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  listings FoodListing[]
}

model FoodListing {
  id String @id @default(uuid()) @db.Uuid
  sellerId String @db.Uuid
  categoryId String @db.Uuid
  name String
  slug String @unique
  description String?
  listingType ListingType
  foodType FoodType
  originalPrice Int
  sellingPrice Int
  quantity Int
  unit ListingUnit
  preparedAt DateTime?
  pickupStart DateTime
  pickupEnd DateTime
  packagingInfo String?
  allergenInfo String?
  status ListingStatus @default(DRAFT)
  publishedAt DateTime?
  expiredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category FoodCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory Inventory?
  images FoodImage[]
  favorites Favorite[]
  cartItems CartItem[]
  orderItems OrderItem[]
  reservations Reservation[]
  donation Donation?
  @@index([sellerId])
  @@index([categoryId])
  @@index([status])
  @@index([foodType])
  @@index([pickupEnd])
  @@index([createdAt])
}

model Inventory {
  id String @id @default(uuid()) @db.Uuid
  listingId String @unique @db.Uuid
  totalQuantity Int
  availableQuantity Int
  reservedQuantity Int @default(0)
  soldQuantity Int @default(0)
  donatedQuantity Int @default(0)
  version Int @default(1)
  updatedAt DateTime @updatedAt
  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
}

model FoodImage {
  id String @id @default(uuid()) @db.Uuid
  listingId String @db.Uuid
  url String
  storageKey String
  altText String
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@index([listingId, sortOrder])
}

model Favorite {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  listingId String @db.Uuid
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@unique([userId, listingId])
  @@index([listingId])
}

model Cart {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id String @id @default(uuid()) @db.Uuid
  cartId String @db.Uuid
  listingId String @db.Uuid
  quantity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  @@unique([cartId, listingId])
  @@index([listingId])
}

model Reservation {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  listingId String @db.Uuid
  quantity Int
  status ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  orderId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  @@index([userId, status])
  @@index([listingId, status])
  @@index([expiresAt])
  @@index([orderId])
}

model Order {
  id String @id @default(uuid()) @db.Uuid
  orderNumber String @unique
  buyerId String @db.Uuid
  status OrderStatus @default(PENDING_PAYMENT)
  fulfillmentMethod FulfillmentMethod @default(PICKUP)
  subtotal Int
  deliveryFee Int @default(0)
  totalAmount Int
  currency String @default("INR")
  buyerName String
  buyerPhone String?
  pickupAddress String?
  pickupCity String?
  pickupPincode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paidAt DateTime?
  cancelledAt DateTime?
  completedAt DateTime?
  buyer User @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items OrderItem[]
  payment Payment?
  pickup Pickup?
  delivery Delivery?
  reservations Reservation[]
  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

model Address {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  label String
  recipientName String
  phone String?
  addressLine1 String
  addressLine2 String?
  locality String?
  city String
  state String
  postalCode String
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, updatedAt])
}

model Delivery {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  providerMode DeliveryProviderMode
  providerReference String?
  status DeliveryStatus @default(PENDING)
  recipientName String
  phone String?
  addressLine1 String
  addressLine2 String?
  locality String?
  city String
  state String
  postalCode String
  latitude Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  assignedAt DateTime?
  pickedUpAt DateTime?
  deliveredAt DateTime?
  failedAt DateTime?
  failureReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([status, createdAt])
}

model Donation {
  id String @id @default(uuid()) @db.Uuid
  listingId String @unique @db.Uuid
  sellerId String @db.Uuid
  status DonationStatus @default(DRAFT)
  quantity Int
  availableQuantity Int
  reservedQuantity Int @default(0)
  collectedQuantity Int @default(0)
  pickupCodeHash String? @unique
  pickupCodeLast4 String?
  qrTokenHash String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  reservations DonationReservation[]
  @@index([status, expiresAt])
  @@index([sellerId, createdAt])
}

model DonationReservation {
  id String @id @default(uuid()) @db.Uuid
  donationId String @db.Uuid
  ngoId String @db.Uuid
  quantity Int
  status DonationReservationStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
  ngo NGOProfile @relation(fields: [ngoId], references: [id], onDelete: Restrict)
  @@unique([donationId, ngoId])
  @@index([ngoId, status, createdAt])
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  listingId String @db.Uuid
  sellerId String @db.Uuid
  listingName String
  unit ListingUnit
  foodType FoodType
  quantity Int
  unitPrice Int
  originalUnitPrice Int
  lineTotal Int
  createdAt DateTime @default(now())
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listing FoodListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  @@index([orderId])
  @@index([listingId])
  @@index([sellerId, createdAt])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  provider String
  providerOrderId String? @unique
  providerPaymentId String? @unique
  amount Int
  currency String @default("INR")
  status PaymentStatus @default(CREATED)
  failureReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paidAt DateTime?
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  webhooks PaymentWebhook[]
}

model PaymentWebhook {
  id String @id @default(uuid()) @db.Uuid
  eventId String @unique
  provider String
  eventType String
  payload Json
  receivedAt DateTime @default(now())
  processedAt DateTime?
  paymentId String? @db.Uuid
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  @@index([paymentId])
}

model Pickup {
  id String @id @default(uuid()) @db.Uuid
  orderId String @unique @db.Uuid
  status PickupStatus @default(PENDING)
  pickupCodeHash String @unique
  pickupCodeLast4 String
  qrTokenHash String @unique
  readyAt DateTime?
  pickedUpAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Account {
  id String @id @default(cuid())
  userId String @db.Uuid
  type String
  provider String
  providerAccountId String
  refresh_token String? @db.Text
  access_token String? @db.Text
  expires_at Int?
  token_type String?
  scope String?
  id_token String? @db.Text
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String @db.Uuid
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  action String
  resourceType String
  resourceId String
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  eventId String
  recipientId String @db.Uuid
  type NotificationType
  channel NotificationChannel
  title String
  body String
  status NotificationDeliveryStatus @default(PENDING)
  metadata Json?
  createdAt DateTime @default(now())
  sentAt DateTime?
  readAt DateTime?
  processedAt DateTime?
  deliveryAttempts Int @default(0)
  nextAttemptAt DateTime?
  lastError String?
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([eventId, recipientId, type, channel])
  @@index([recipientId, channel, createdAt])
  @@index([status, nextAttemptAt])
}

model NotificationPreference {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  emailNotifications Boolean @default(true)
  smsNotifications Boolean @default(false)
  pushNotifications Boolean @default(false)
  whatsappNotifications Boolean @default(false)
  marketingNotifications Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
